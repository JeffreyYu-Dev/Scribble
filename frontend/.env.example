VITE_API_URL=http://localhost:8080
VITE_SOCKET_URL=ws://localhost:8080/scribble

# Playing over a LAN: point both at this machine's address instead
# (http://192.168.x.x:8080), and start the backend with the frontend's origin
# allowed, or the browser blocks the calls as cross-origin:
#
#   SCRIBBLE_ORIGINS=http://192.168.x.x:3000 go run ./cmd :8080
